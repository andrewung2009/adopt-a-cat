# Copy to .env and adjust
PORT=3000
DB_PATH=./db/cats.db
SESSION_SECRET=change-me-to-a-long-random-string
# Dev/test email via Ethereal. In production point at your real SMTP.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where applications and notifications are delivered.
SHELTER_EMAIL=shelter@example.com
APP_URL=http://localhost:3000